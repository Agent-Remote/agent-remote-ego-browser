{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-remote.dev/schemas/ego-browser-bridge-v1/request-permit.schema.json",
  "title": "Ego Browser Bridge one-time request permit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "generation",
    "request_id",
    "sequence",
    "expires_at_unix_ms",
    "max_payload_bytes",
    "max_script_bytes",
    "default_task_space",
    "allowlist_revision",
    "learning_bundle_digest",
    "concurrency_mode",
    "task_space_scope",
    "tab_scope"
  ],
  "properties": {
    "binding_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generation": { "type": "integer", "minimum": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 1 },
    "expires_at_unix_ms": { "type": "integer", "minimum": 1 },
    "max_payload_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "max_script_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "default_task_space": {
      "type": "string",
      "minLength": 14,
      "maxLength": 256,
      "pattern": "^agent-remote:[A-Za-z0-9_:-]+$"
    },
    "allowlist_revision": { "type": "integer", "minimum": 1 },
    "learning_bundle_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "concurrency_mode": { "enum": ["task_space_tab", "task_space", "binding"] },
    "task_space_scope": { "type": ["string", "null"], "maxLength": 256 },
    "tab_scope": { "type": ["string", "null"], "maxLength": 256 }
  }
}
