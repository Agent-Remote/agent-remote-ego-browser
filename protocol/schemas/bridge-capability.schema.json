{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-remote.dev/schemas/ego-browser-bridge-v1/bridge-capability.schema.json",
  "title": "Ego Browser Bridge capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bridge_protocol_version",
    "remote_wrapper_version",
    "local_ego_browser_runtime_version",
    "ego_lite_runtime_version",
    "skill_version",
    "release_profile",
    "signer_certificate_sha256",
    "credential_profile",
    "allowlist_revision",
    "allowlist_roots_digest",
    "learning_bundle_digest",
    "max_parallel_requests",
    "max_script_bytes",
    "max_execute_timeout_ms",
    "supported_concurrency",
    "capabilities",
    "remote_platform",
    "local_platform"
  ],
  "properties": {
    "bridge_protocol_version": { "const": "ego-browser-bridge-v1" },
    "remote_wrapper_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "local_ego_browser_runtime_version": { "const": "0.4.7.4" },
    "ego_lite_runtime_version": { "const": "0.4.7.4" },
    "skill_version": { "const": "1.2.3" },
    "release_profile": { "enum": ["logic-test", "development-local", "community-local-trust", "developer-id"] },
    "signer_certificate_sha256": { "type": "string", "minLength": 1, "maxLength": 128 },
    "credential_profile": { "enum": ["community_file", "keychain_access_group"] },
    "allowlist_revision": { "type": "integer", "minimum": 1 },
    "allowlist_roots_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "learning_bundle_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "max_parallel_requests": { "type": "integer", "minimum": 1, "maximum": 4 },
    "max_script_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "max_execute_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
    "supported_concurrency": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["task_space_tab", "task_space", "binding"] }
    },
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ego_browser_script_execute_v1",
          "ego_browser_snapshot_v1",
          "ego_browser_screenshot_artifact_v1",
          "ego_browser_task_space_v1",
          "ego_browser_concurrency_v1",
          "ego_browser_file_allowlist_v1",
          "ego_browser_site_learning_v1"
        ]
      }
    },
    "remote_platform": { "const": "linux" },
    "local_platform": { "const": "macos" }
  }
}
